# Dependencies
node_modules/

# Build output
dist/
build/

# Database (generated at build time by scripts/build-db.js or import_data.py)
# import_data.py writes build.db to the repo root; build-db.js writes public/build.db
*.db
*.sqlite
*.sqlite3
public/build.db

# Datasheet PDFs (source material, not app code — see docs/SWITCH_AP_ROLLOUT.md)
datasheets/*.pdf
datasheets/*.PDF

# Vendor spreadsheets used to populate the CSVs (the CSV is the source of truth)
*.xlsx
*.xls

# Python
__pycache__/
*.pyc

# Environment
.env
.env.local
.env.production
.env.*.local
*.local

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# AI agent session state
.claude/
.cursor/
.aider*

# Atomic-write and scratch leftovers
*.tmp
*.tmp.*
.eslintcache

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Vercel
.vercel
